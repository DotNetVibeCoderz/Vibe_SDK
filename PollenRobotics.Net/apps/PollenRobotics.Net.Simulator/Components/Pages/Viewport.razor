@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject PollenRobotics.Net.Simulation.SimulationEngine Engine

<h1 class="visually-hidden">Robot viewport</h1>

<canvas id="viewport"></canvas>

<div class="hud" aria-live="polite">
    <span class="hud-robot">@_robotName</span>
    <span class="hud-sep">·</span>
    <span class="hud-clock">t=@_clock.ToString("0.0")s</span>
    <span class="hud-sep">·</span>
    <span class="hud-state @(_running ? "is-running" : "is-idle")">@(_running ? "running" : "idle")</span>
</div>

@if (_error is not null)
{
    <div class="viewport-error" role="alert">
        <strong>The viewport could not start.</strong>
        <p>@_error</p>
    </div>
}

@code {
    // 30 Hz. Past what anyone perceives as smooth and well inside what a SignalR circuit carries
    // comfortably; the simulation keeps its own rate regardless of what this does.
    private static readonly TimeSpan FramePeriod = TimeSpan.FromMilliseconds(33);

    private IJSObjectReference? _module;
    private DotNetObjectReference<Viewport>? _self;
    private PeriodicTimer? _timer;
    private Task? _pump;
    private CancellationTokenSource? _stopping;

    private string _robotName = "Reachy Mini";
    private double _clock;
    private bool _running;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/viewport.js");
            _self = DotNetObjectReference.Create(this);

            if (!await _module.InvokeAsync<bool>("init", "viewport", _self))
            {
                _error = "The 3D viewport could not start. The log panel has the reason.";
                StateHasChanged();
                return;
            }

            // Match the shell's theme before the first frame, so the viewport does not flash the
            // wrong palette on load.
            await _module.InvokeVoidAsync("setTheme", ViewportTheme.Current);
            ViewportTheme.Changed += OnThemeChanged;

            _stopping = new CancellationTokenSource();
            _timer = new PeriodicTimer(FramePeriod);
            _pump = PumpFramesAsync(_stopping.Token);
        }
        catch (JSException ex)
        {
            // A desktop app has no console anyone will look at, so the failure has to reach the
            // page - and the log panel, via the engine's sink.
            _error = ex.Message;
            Engine.Log.Error("viewport", $"Failed to start the 3D viewport: {ex.Message}");
            StateHasChanged();
        }
    }

    /// <summary>
    /// Pushes one frame of joint angles per tick.
    /// </summary>
    /// <remarks>
    /// A timer rather than a subscription to <c>FrameProduced</c>: the engine ticks at 50 Hz and
    /// fires on its own thread, and marshalling every one of those onto the circuit would queue
    /// frames faster than they drain. Sampling the latest snapshot decouples the two rates.
    /// </remarks>
    private async Task PumpFramesAsync(CancellationToken cancellationToken)
    {
        if (_timer is not { } timer || _module is not { } module)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                PollenRobotics.Net.Simulation.SimulationSnapshot snapshot = Engine.LatestSnapshot;

                double[] joints = [.. snapshot.JointPositions];

                (double roll, double pitch, double yaw) = Rpy(snapshot.BodyPose);

                var body = new
                {
                    x = snapshot.BodyPose.Position.X,
                    y = snapshot.BodyPose.Position.Y,
                    z = snapshot.BodyPose.Position.Z,
                    roll,
                    pitch,
                    yaw,
                };

                await module.InvokeVoidAsync("applyFrame", cancellationToken, snapshot.Kind.ToString(), joints, body);

                _robotName = Engine.Robot.Description.DisplayName;
                _clock = snapshot.SimulationTime.TotalSeconds;
                _running = Engine.IsRunning;

                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown.
        }
        catch (JSDisconnectedException)
        {
            // The browser navigated away or the window closed. Not an error.
        }
        catch (Exception ex)
        {
            Engine.Log.Error("viewport", $"Frame pump stopped: {ex.Message}");
        }
    }

    /// <summary>
    /// Receives a message from the viewport's JavaScript.
    /// </summary>
    /// <remarks>
    /// This is the only route a browser-side failure has into the application. Without it a broken
    /// rig or a missing module leaves an empty canvas and nothing anywhere that says why.
    /// </remarks>
    /// <summary>Switches the viewport's palette to match the desktop shell.</summary>
    public async Task SetThemeAsync(string theme)
    {
        if (_module is { } module)
        {
            try
            {
                await module.InvokeVoidAsync("setTheme", theme);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; the next page load will pick the theme up from the shell.
            }
        }
    }

    [JSInvokable]
    public void ReportFromBrowser(string level, string message)
    {
        if (level == "error")
        {
            Engine.Log.Error("viewport", message);
            _error = message;
            InvokeAsync(StateHasChanged);
            return;
        }

        Engine.Log.Info("viewport", message);
    }

    private static (double Roll, double Pitch, double Yaw) Rpy(PollenRobotics.Net.Core.Geometry.Pose pose)
    {
        (PollenRobotics.Net.Core.Geometry.Angle roll,
         PollenRobotics.Net.Core.Geometry.Angle pitch,
         PollenRobotics.Net.Core.Geometry.Angle yaw) = pose.Rpy;

        return (roll.Radians, pitch.Radians, yaw.Radians);
    }

    private void OnThemeChanged(string theme) => _ = InvokeAsync(() => SetThemeAsync(theme));

    public async ValueTask DisposeAsync()
    {
        ViewportTheme.Changed -= OnThemeChanged;

        if (_stopping is not null)
        {
            await _stopping.CancelAsync();
        }

        _timer?.Dispose();

        if (_pump is not null)
        {
            try
            {
                await _pump;
            }
            catch (Exception)
            {
                // Already reported by the pump itself.
            }
        }

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; there is nothing to dispose on the other side.
            }
        }

        _self?.Dispose();
        _stopping?.Dispose();
    }
}
