<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Reachy 2 SDK for .NET (unofficial)</Title>
    <Description>.NET client for Reachy 2: both seven-axis arms, the Orbita neck, grippers and the mobile base, over the official reachy2-sdk-api gRPC contract.</Description>
    <PackageTags>$(PackageTags);reachy2;grpc</PackageTags>
    <!-- The generated protobuf code is machine-written and does not carry XML docs, and a few
         members shadow inherited ones by design. Neither is worth a build warning. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PollenRobotics.Net.Core/PollenRobotics.Net.Core.csproj" />
    <ProjectReference Include="../PollenRobotics.Net.Kinematics/PollenRobotics.Net.Kinematics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The .proto files are Pollen Robotics' own, vendored verbatim from reachy2-sdk-api under
       Apache 2.0 (see Protos/LICENSE-reachy2-sdk-api.txt). They are the wire contract: field
       numbers have to match the robot exactly, so these are copied, never hand-written.
       tools/sync-protos.ps1 refreshes them. -->
  <ItemGroup>
    <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="Client" />
  </ItemGroup>

</Project>
