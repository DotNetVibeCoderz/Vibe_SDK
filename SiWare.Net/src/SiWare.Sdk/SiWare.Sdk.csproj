<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Gravicode.SiWare.Sdk</PackageId>
    <Title>SiWare.NET SDK</Title>
    <Description>.NET 10 SDK for Si-Ware spectral sensors: validated spectrum model, deterministic simulator, vendor-driver bridge, calibration (dark/reference/absorbance), SNV and smoothing, JSON/CSV exchange, and optional Rust DSP kernels. Created by Gravicode Studios, led by Kang Fadhil. Not affiliated with Si-Ware Systems.</Description>
    <PackageTags>siware;spectrometer;nir;spectroscopy;sensor;driver;dsp;rust</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\scripts\vendor_bridge.py" Pack="true" PackagePath="contentFiles/any/any/SiWare/vendor_bridge.py" PackageCopyToOutput="true" BuildAction="None" />
  </ItemGroup>

  <!-- Ships the Rust kernels only when a release build exists; NativeDsp reports unavailability otherwise. -->
  <ItemGroup Condition="Exists('..\..\native\siware-dsp\target\release\siware_dsp.dll')">
    <None Include="..\..\native\siware-dsp\target\release\siware_dsp.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
  </ItemGroup>

</Project>
