<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TypeSafe.JevGallery.MainWindow"
        Title="Jev Gallery — TypeSafe SDK specimen catalogue"
        Width="1280" Height="740" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bark}">

  <Grid RowDefinitions="*,Auto" ColumnDefinitions="238,320,*">

    <!-- ════ Rail: identity and domain filter ════════════════════════════════ -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Casing}"
            BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
      <DockPanel Margin="24,28,20,20">

        <StackPanel DockPanel.Dock="Top">
          <TextBlock Classes="display" Text="JEV" FontSize="54" FontWeight="SemiBold" LetterSpacing="-1" />
          <TextBlock Classes="display" Text="GALLERY" FontSize="19" LetterSpacing="7.5"
                     Foreground="{StaticResource Brass}" Margin="0,-6,0,0" />
          <TextBlock Classes="body" FontSize="12" Margin="0,16,0,0"
                     Text="Fifteen runnable use cases for the TypeSafe .NET SDK — every one calls System One for real." />
          <Border Height="1" Background="{StaticResource Rule}" Margin="0,22,0,18" />
          <TextBlock Classes="eyebrow" Text="DOMAINS" Margin="0,0,0,10" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Height="1" Background="{StaticResource Rule}" Margin="0,16,0,2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="ModeDot" Width="7" Height="7" CornerRadius="4"
                    Background="{StaticResource Moss}" VerticalAlignment="Center" />
            <TextBlock x:Name="ModeText" Classes="eyebrow" Text="SIMULATOR" VerticalAlignment="Center" />
          </StackPanel>
          <CheckBox x:Name="MotionToggle" IsChecked="True" Content="Animate results"
                    FontFamily="{StaticResource Body}" FontSize="12" Foreground="{StaticResource Ash}" />
        </StackPanel>

        <StackPanel x:Name="DomainList" Spacing="2" VerticalAlignment="Top" />
      </DockPanel>
    </Border>

    <!-- ════ Catalogue: specimen accession list ══════════════════════════════ -->
    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="22,28,22,14" ColumnDefinitions="*,Auto">
          <TextBlock Classes="eyebrow" Text="SPECIMENS" VerticalAlignment="Center" />
          <TextBlock x:Name="SpecimenCount" Grid.Column="1" Classes="eyebrow"
                     Foreground="{StaticResource Brass}" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Padding="0,0,0,24">
          <StackPanel x:Name="SpecimenList" Margin="14,0,14,0" Spacing="2" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ════ Detail: input, distribution, code ═══════════════════════════════ -->
    <ScrollViewer Grid.Row="0" Grid.Column="2" Padding="0,0,8,0">
      <StackPanel Margin="40,30,36,40" MaxWidth="820" HorizontalAlignment="Left">

        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock x:Name="DetailAccession" Classes="eyebrow" Foreground="{StaticResource Brass}" />
          <TextBlock x:Name="DetailDomain" Classes="eyebrow" />
        </StackPanel>

        <TextBlock x:Name="DetailTitle" Classes="display" FontSize="42" FontWeight="SemiBold"
                   LetterSpacing="-0.5" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock x:Name="DetailBlurb" Classes="body" MaxWidth="620" HorizontalAlignment="Left" Margin="0,12,0,0" />

        <TextBlock Classes="eyebrow" Text="INPUT" Margin="0,30,0,9" />
        <TextBox x:Name="InputBox" Classes="field" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="94" />

        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,16,0,0">
          <Button x:Name="RunButton" Classes="run" Content="RUN SPECIMEN" />
          <Button x:Name="ResetButton" Classes="ghost" Content="RESET INPUT" />
          <TextBlock x:Name="RunNote" Classes="eyebrow" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="ModeNote" Classes="body" FontSize="12" MaxWidth="620"
                   HorizontalAlignment="Left" Margin="0,14,0,0" />

        <TextBlock Classes="eyebrow" Text="ANSWER" Margin="0,34,0,12" />
        <StackPanel x:Name="ResultPanel" Spacing="26" />

        <Grid Margin="0,36,0,10" ColumnDefinitions="*,Auto">
          <TextBlock Classes="eyebrow" Text="SAMPLE CODE" VerticalAlignment="Center" />
          <Button x:Name="CopyButton" Grid.Column="1" Classes="ghost" Content="COPY" Padding="11,5" />
        </Grid>
        <Border Background="{StaticResource Recess}" BorderBrush="{StaticResource Rule}"
                BorderThickness="1" CornerRadius="2" Padding="20,18">
          <SelectableTextBlock x:Name="CodeBlock" FontFamily="{StaticResource Mono}" FontSize="12.5"
                               LineHeight="20" Foreground="{StaticResource Bone}"
                               SelectionBrush="{StaticResource MossDim}" TextWrapping="NoWrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ════ Status bar ══════════════════════════════════════════════════════ -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Casing}"
            BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="24,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Classes="eyebrow" Foreground="{StaticResource Bone}" />
        <TextBlock Grid.Column="1" Classes="eyebrow"
                   Text="GRAVICODE STUDIOS · KANG FADHIL · JACK — THE CODE BENDER" />
      </Grid>
    </Border>
  </Grid>
</Window>
