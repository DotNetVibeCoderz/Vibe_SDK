<Window x:Class="TypeSafe.BoardGames.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TypeSafe Arcade • Board Games" Width="1440" Height="900" MinWidth="1120" MinHeight="740" Background="#060B18" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Segoe UI"><Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#172B50"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#34527E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style><Style x:Key="GameButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="15,12"/></Style><Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#8099C5"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/></Style><DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.38"/></Window.Resources><Grid Background="#071124"><Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#0C1830" CornerRadius="17" Padding="22,0" BorderBrush="#20395E" BorderThickness="1" Effect="{StaticResource PanelShadow}"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="9" Background="#3BA7FF" Margin="0,0,12,0"><TextBlock Text="T" Foreground="#071222" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="TYPESAFE ARCADE" Foreground="#F