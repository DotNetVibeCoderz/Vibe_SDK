<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <RootNamespace>TypeSafeSdk</RootNamespace>
    <AssemblyName>TypeSafeSdk</AssemblyName>
  </PropertyGroup>

  <!-- Versi tunggal: harus sama dengan TypeSafeConstants.SdkVersion, yang dikirim pada header X-TypeSafe-SDK. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <PackageId>Gravicode.TypeSafeSdk</PackageId>
    <Title>TypeSafe .NET SDK (unofficial)</Title>
    <Authors>Gravicode Studios</Authors>
    <Company>Gravicode Studios</Company>
    <Product>TypeSafe .NET SDK</Product>
    <Description>Unofficial, strongly typed .NET 10 client for the TypeSafe System One API, ported from the official Python SDK. Choice, noul, and score questions; typed exceptions per status code; retry with jitter and Retry-After; per-call timeout, headers, and body; and a deterministic offline simulator for tests and CI.</Description>
    <PackageTags>typesafe;systemone;jev;llm;classification;ai;sdk;avalonia;blazor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_SDK</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_SDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) Gravicode Studios</Copyright>
    <PackageReleaseNotes>Parity pass against the official Python SDK: full typed exception hierarchy, request ids, Retry-After, client-level retry and timeout, custom headers and extra body, TypeSafeConstants, ListModelsResponse, and a simulator that answers choice, noul, and score questions.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Hanya ILogger yang dibutuhkan dari luar framework dasar. Memakai package abstractions,
    bukan FrameworkReference Microsoft.AspNetCore.App, supaya paket ini tetap bisa dipakai
    aplikasi console, desktop, dan mobile, bukan hanya aplikasi web.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
