<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TypeSafeAppGen.MainWindow" Width="1500" Height="930" MinWidth="1100" MinHeight="700" Title="TypeSafe App Generator — Jack, The Code Bender" Background="#080F20">
<Grid RowDefinitions="42,44,*,26">
<Menu Background="#0C1730" Foreground="#DDE8FF"><MenuItem Header="File"><MenuItem Header="New Project" Click="NewProject_Click"/><MenuItem Header="Open Project / File" Click="OpenProject_Click"/><MenuItem Header="Close Project" Click="CloseProject_Click"/><Separator/><MenuItem Header="Exit" Click="Exit_Click"/></MenuItem><MenuItem Header="Edit"><MenuItem Header="Go To Line" Click="GoToLine_Click"/><MenuItem Header="Format Code" Click="FormatCode_Click"/><MenuItem Header="Show Line Numbers" Click="LineNumbers_Click"/></MenuItem><MenuItem Header="Build"><MenuItem Header="Build" Click="Build_Click"/><MenuItem Header="Run" Click="Run_Click"/><MenuItem Header="Deploy" Click="Deploy_Click"/></MenuItem><MenuItem Header="Tools"><MenuItem Header="Settings" Click="Settings_Click"/><MenuItem Header="Template Gallery" Click="Templates_Click"/></MenuItem></Menu>
<Border Grid.Row="1" Background="#101E3A" BorderBrush="#203B68" BorderThickness="0,1"><StackPanel Orientation="Horizontal" Spacing="8" Margin="10,6"><Button Content="New" Click="NewProject_Click"/><Button Content="Open" Click="OpenProject_Click"/><Button Content="Format" Click="FormatCode_Click"/><Button Content="Build" Click="Build_Click"/><Button Content="Run" Click="Run_Click"/><Button Content="Deploy" Click="Deploy_Click"/><Separator Width="16"/><TextBlock Text="JACK / THE CODE BENDER" Foreground="#75E4CC" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock x:Name="ProjectLabel" Text="No project opened" Foreground="#91A6CE" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Border>
<Grid Grid.Row="2" ColumnDefinitions="250,5,*,5,360" x:Name="Workspace">
<Border Grid.Column="0" Background="#0D1930" BorderBrush="#203B68" BorderThickness="0,0,1,0"><Grid RowDefinitions="44,*"><TextBlock Text="EXPLORER" Foreground="#85A1CE" FontSize="11" FontWeight="Bold" Margin="16,16"/><TreeView x:Name="Explorer" Grid.Row="1" Margin="8" SelectionChanged="Explorer_SelectionChanged"/></Grid></Border>
<GridSplitter Grid.Column="1" Width="5" Background="#203B68" ResizeDirection="Columns"/>
<Grid Grid.Column="2" RowDefinitions="34,*,180"><Border Background="#101E3A" BorderBrush="#203B68" BorderThickness="0,0,0,1"><TextBlock x:Name="EditorTitle" Text="WELCOME.md" Foreground="#DDE8FF" Margin="16,9" FontSize="12"/></Border><TextBox x:Name="Editor" Grid.Row="1" Background="#091225" Foreground="#E4EDFF" FontFamily="Cascadia Code, Consolas" FontSize="14" AcceptsReturn="True" TextWrapping="NoWrap"/><Border Grid.Row="2" Background="#0B1630" BorderBrush="#203B68" BorderThickness="0,1,0,0"><Grid RowDefinitions="34,*"><StackPanel Orientation="Horizontal" Spacing="16" Margin="14,8"><TextBlock Text="OUTPUT" Foreground="#75E4CC" FontWeight="Bold" FontSize="11"/><TextBlock Text="LOGS" Foreground="#8BA2CD" FontSize="11"/></StackPanel><TextBox x:Name="Logs" Grid.Row="1" Background="#080F20" Foreground="#AFC2E7" FontFamily="Cascadia Code, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="8"/></Grid></Border></Grid>
<GridSplitter Grid.Column="3" Width="5" Background="#203B68" ResizeDirection="Columns"/>
<Border Grid.Column="4" x:Name="ChatPanel" Background="#0D1930" BorderBrush="#203B68" BorderThickness="1,0,0,0"><Grid RowDefinitions="54,*,Auto,94"><Border Background="#112442" Padding="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="JACK" Foreground="#75E4CC" FontWeight="Bold"/><TextBlock Text="THE CODE BENDER" Foreground="#8EA7D3" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox x:Name="ModelPicker" Width="115" SelectedIndex="0"><ComboBoxItem Content="Ollama"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Claude"/><ComboBoxItem Content="Gemini"/></ComboBox><Button Content="Hide" Margin="8,0,0,0" Click="HideChat_Click"/></StackPanel></Grid></Border><ScrollViewer Grid.Row="1"><ItemsControl x:Name="ChatHistory" Margin="12"/></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,0"><Button Content="Attach image" Click="AttachImage_Click"/><Button Content="Clear" Click="ClearChat_Click" Margin="8,0,0,0"/></StackPanel><Grid Grid.Row="3" Margin="10" ColumnDefinitions="*,76"><TextBox x:Name="ChatInput" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Ask Jack to generate UI or backend code… (Ctrl+Enter)" KeyDown="ChatInput_KeyDown"/><Button Grid.Column="1" Content="Send" Click="SendChat_Click" Margin="8,0,0,0"/></Grid></Grid></Border>
</Grid>
<Border Grid.Row="3" Background="#101E3A" BorderBrush="#203B68" BorderThickness="0,1,0,0"><DockPanel Margin="12,4"><TextBlock x:Name="StatusText" Text="Ready" Foreground="#A8BCE0"/><TextBlock DockPanel.Dock="Right" Text="Gravicode Studios • Led by Kang Fadhil" Foreground="#7189B7"/></DockPanel></Border>
</Grid></Window>
