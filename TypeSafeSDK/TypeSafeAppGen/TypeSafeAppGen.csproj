<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Konektor Semantic Kernel untuk Gemini, Ollama, dan endpoint kustom masih berlabel eksperimental. -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0070</NoWarn>
    <Product>TypeSafe App Generator</Product>
    <Company>Gravicode Studios</Company>
    <Authors>Gravicode Studios dipimpin Kang Fadhil</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.4.1" />
    <PackageReference Include="Anthropic" Version="12.42.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.80.1-alpha" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.80.1-alpha" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TypeSafeSdk/TypeSafeSdk.csproj" />
  </ItemGroup>

  <!-- Template proyek adalah file sumber milik aplikasi hasil generate, bukan bagian dari AppGen. -->
  <ItemGroup>
    <Compile Remove="Templates/**" />
    <AvaloniaXaml Remove="Templates/**" />
    <None Remove="Templates/**" />
    <Content Include="Templates/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Editor/patina-theme.json" LogicalName="TypeSafeAppGen.Editor.patina-theme.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TypeSafeAppGen.Tests" />
  </ItemGroup>

</Project>
