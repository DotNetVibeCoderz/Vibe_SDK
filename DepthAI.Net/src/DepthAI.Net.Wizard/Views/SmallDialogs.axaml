<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepthAI.Wizard.App.Views.GoToLineDialog"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceDeep}"
        Title="Ke Baris">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="RangeText" Classes="caption" />
    <TextBox x:Name="LineBox" KeyDown="OnKeyDown" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="ghost" Click="OnCancel">Batal</Button>
      <Button Classes="primary" Click="OnGo">Ke Sana</Button>
    </StackPanel>
  </StackPanel>
</Window>
