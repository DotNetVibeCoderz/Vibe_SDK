<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepthAI.Wizard.App.Views.SettingsDialog"
        Width="620" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceAbyss}"
        Title="Pengaturan Asisten">

  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Margin="24,20,24,0" Spacing="4">
      <TextBlock Text="Pengaturan Asisten" FontSize="18" FontWeight="SemiBold"
                 Foreground="{DynamicResource InkBright}" />
      <TextBlock Classes="caption"
                 Text="Tersimpan di app.config, di samping aplikasi. Kunci API sebaiknya lewat variabel lingkungan." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="24,18,24,0">
      <StackPanel Spacing="16">

        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Penyedia model" />
          <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch"
                    SelectionChanged="OnProviderChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Model" />
          <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch" IsEditable="True" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Endpoint (opsional)" />
          <TextBox x:Name="EndpointBox" PlaceholderText="mis. http://localhost:11434/v1" />
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="caption" Text="Kunci API" />
            <TextBlock Grid.Column="1" x:Name="KeySourceText" Classes="caption" />
          </Grid>
          <TextBox x:Name="ApiKeyBox" PasswordChar="•" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Kunci Tavily — untuk fungsi pencarian internet" />
          <TextBox x:Name="TavilyBox" PasswordChar="•" />
        </StackPanel>

        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="caption" Text="Temperature" />
            <TextBlock Grid.Column="1" x:Name="TemperatureText" Classes="metric" />
          </Grid>
          <Slider x:Name="TemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                  IsSnapToTickEnabled="True" PropertyChanged="OnTemperatureChanged" />
          <TextBlock Classes="caption"
                     Text="Rendah membuat jawaban konsisten dan cocok untuk kode; tinggi lebih bervariasi." />
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Classes="caption" Text="Maks token balasan" />
            <TextBox x:Name="MaxTokensBox" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Classes="caption" Text="Pesan riwayat yang dikirim" />
            <TextBox x:Name="HistoryBox" />
          </StackPanel>
        </Grid>

        <CheckBox x:Name="FunctionsBox" FontSize="12">
          <StackPanel Spacing="2">
            <TextBlock Text="Izinkan asisten memanggil fungsi" FontSize="12"
                       Foreground="{DynamicResource InkBright}" />
            <TextBlock Classes="caption"
                       Text="Menulis berkas, membuat pipeline, memindai perangkat, mencari di internet." />
          </StackPanel>
        </CheckBox>

        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Persona (system prompt)" />
          <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" Height="150"
                   TextWrapping="Wrap" FontFamily="{DynamicResource MonoFont}" FontSize="11" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Margin="0,18,0,0" Padding="24,14"
            Background="{DynamicResource SurfaceDeep}"
            BorderBrush="{DynamicResource HairLine}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="StatusText" Classes="caption" VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Click="OnCancel">Batal</Button>
          <Button Classes="primary" Click="OnSave">Simpan</Button>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
