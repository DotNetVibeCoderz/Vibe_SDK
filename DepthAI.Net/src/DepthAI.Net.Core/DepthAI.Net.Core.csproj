<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DepthAI</RootNamespace>
    <AssemblyName>DepthAI.Net</AssemblyName>
    <PackageId>DepthAI.Net</PackageId>
    <Description>SDK .NET idiomatik untuk DepthAI API V3 (kamera OAK dari Luxonis). Pipeline node graph, stereo depth, neural inference, dan stream reaktif tanpa perlu Python.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DepthAI.Net.Core.Tests" />
    <InternalsVisibleTo Include="DepthAI.Net.Cli" />
  </ItemGroup>

</Project>
