<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DepthAI</RootNamespace>
    <AssemblyName>DepthAI.Net</AssemblyName>
    <PackageId>DepthAI.Net</PackageId>
    <Description>SDK .NET idiomatik untuk DepthAI API V3 (kamera OAK dari Luxonis). Pipeline node graph, stereo depth, neural inference, dan stream reaktif tanpa perlu Python.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DepthAI.Net.Core.Tests" />
    <InternalsVisibleTo Include="DepthAI.Net.Cli" />
  </ItemGroup>

  <!--
    Runtime native hasil native/depthai-c/build.ps1 (win-x64) dan build.sh (linux-x64,
    linux-arm64), bila sudah dibangun. Item None dengan CopyTo*Directory mengalir transitif
    lewat ProjectReference, jadi CLI, Wizard, sample, dan proyek Wizard di dalam repo
    otomatis bisa memakai hardware. Semuanya disalin apa pun OS build-nya, supaya tool CLI
    yang di-pack sekali jalan di setiap platform. Pack="false": paket NuGet DepthAI.Net
    tetap kecil; konsumen paket memakai DepthAI.Net.Runtime.<rid>.

    Windows disalin rata ke folder output. Linux per RID ke runtimes/<rid>/native, karena
    x64 dan arm64 memakai nama berkas yang sama; Interop/NativeLibraryResolver memuatnya
    dari sana.
  -->
  <PropertyGroup>
    <DepthAiNativeDir>$(MSBuildThisFileDirectory)..\..\artifacts\native\</DepthAiNativeDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(DepthAiNativeDir)win-x64\depthai-c.dll')">
    <None Include="$(DepthAiNativeDir)win-x64\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="false"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DepthAiNativeDir)linux-x64\libdepthai-c.so')">
    <None Include="$(DepthAiNativeDir)linux-x64\*.so*"
          Link="runtimes\linux-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="false"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DepthAiNativeDir)linux-arm64\libdepthai-c.so')">
    <None Include="$(DepthAiNativeDir)linux-arm64\*.so*"
          Link="runtimes\linux-arm64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="false"
          Visible="false" />
  </ItemGroup>

</Project>
