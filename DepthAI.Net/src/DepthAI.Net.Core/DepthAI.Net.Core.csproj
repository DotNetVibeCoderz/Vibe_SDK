<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DepthAI</RootNamespace>
    <AssemblyName>DepthAI.Net</AssemblyName>
    <PackageId>DepthAI.Net</PackageId>
    <Description>SDK .NET idiomatik untuk DepthAI API V3 (kamera OAK dari Luxonis). Pipeline node graph, stereo depth, neural inference, dan stream reaktif tanpa perlu Python.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DepthAI.Net.Core.Tests" />
    <InternalsVisibleTo Include="DepthAI.Net.Cli" />
  </ItemGroup>

  <!--
    Runtime native hasil native/depthai-c/build.ps1, bila sudah dibangun. Item None dengan
    CopyTo*Directory mengalir transitif lewat ProjectReference, jadi CLI, Wizard, sample,
    dan proyek Wizard di dalam repo otomatis bisa memakai hardware. Pack="false": paket
    NuGet DepthAI.Net tetap kecil; konsumen paket memakai DepthAI.Net.Runtime.win-x64.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\native\win-x64\depthai-c.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\native\win-x64\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Pack="false"
          Visible="false" />
  </ItemGroup>

</Project>
