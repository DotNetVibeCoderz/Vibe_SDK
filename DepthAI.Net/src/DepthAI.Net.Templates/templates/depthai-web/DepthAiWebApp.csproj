<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DepthAiWebApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DepthAI.Net" Version="0.3.0" />
    <!-- Runtime native untuk kamera OAK sungguhan; tanpanya SDK memakai simulasi. -->
    <PackageReference Include="DepthAI.Net.Runtime.win-x64" Version="0.3.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="DepthAI.Net.Imaging.ImageSharp" Version="0.3.0" />
  </ItemGroup>

</Project>