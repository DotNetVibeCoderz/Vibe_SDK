<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DepthAI.Net" Version="0.5.0" />
    <!-- Runtime native untuk kamera OAK sungguhan (Windows x64, Linux x64/arm64); tanpanya SDK memakai simulasi. -->
    <PackageReference Include="DepthAI.Net.Runtime.win-x64" Version="0.5.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="DepthAI.Net.Runtime.linux-x64" Version="0.5.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="DepthAI.Net.Runtime.linux-arm64" Version="0.5.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="DepthAI.Net.Imaging.ImageSharp" Version="0.5.0" />
  </ItemGroup>

</Project>
