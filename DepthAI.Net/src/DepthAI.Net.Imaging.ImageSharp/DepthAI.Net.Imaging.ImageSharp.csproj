<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DepthAI.Imaging</RootNamespace>
    <AssemblyName>DepthAI.Net.Imaging.ImageSharp</AssemblyName>
    <PackageId>DepthAI.Net.Imaging.ImageSharp</PackageId>
    <Description>Adapter ImageSharp untuk DepthAI.Net: konversi frame ke Image&lt;Rgb24&gt;, encoding PNG/JPEG, dan visualisasi peta kedalaman.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Ditahan di 3.1.x, bukan 4.x. Sejak 4.0.0 paket ImageSharp menjalankan
      ValidateLicenseTask sebelum CoreCompile dan menggagalkan build kalau tidak
      menemukan SixLaborsLicenseKey, SixLaborsLicenseFile, atau berkas sixlabors.lic.
      Tanpa lisensi Six Labors, setiap mesin bersih dan setiap runner CI gagal build.
      Naikkan ke 4.x hanya bersamaan dengan menyediakan lisensinya.
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DepthAI.Net.Core\DepthAI.Net.Core.csproj" />
  </ItemGroup>

</Project>
