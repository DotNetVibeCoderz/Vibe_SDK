{
  "config_version": "1.0",
  "model": {
    "metadata": {
      "name": "YuNet-640x480",
      "path": "yunet-s-480x640.superblob",
      "precision": "float16"
    },
    "inputs": [
      {
        "name": "input",
        "dtype": "uint8",
        "input_type": "image",
        "shape": [
          1,
          3,
          480,
          640
        ],
        "layout": "NCHW",
        "preprocessing": {
          "mean": [
            0.0,
            0.0,
            0.0
          ],
          "scale": [
            1.0,
            1.0,
            1.0
          ],
          "reverse_channels": false,
          "interleaved_to_planar": false,
          "dai_type": null
        }
      }
    ],
    "outputs": [
      {
        "name": "loc",
        "dtype": "float16",
        "shape": [
          17610,
          14
        ],
        "layout": "CD"
      },
      {
        "name": "conf",
        "dtype": "float16",
        "shape": [
          17610,
          2
        ],
        "layout": "CD"
      },
      {
        "name": "iou",
        "dtype": "float16",
        "shape": [
          17610,
          1
        ],
        "layout": "CD"
      }
    ],
    "heads": [
      {
        "name": null,
        "parser": "YuNetParser",
        "metadata": {
          "postprocessor_path": null,
          "conf_threshold": 0.6,
          "input_size": [
            640,
            480
          ],
          "iou_threshold": 0.3,
          "max_det": 5000
        },
        "outputs": [
          "loc",
          "conf",
          "iou"
        ]
      }
    ]
  }
}
