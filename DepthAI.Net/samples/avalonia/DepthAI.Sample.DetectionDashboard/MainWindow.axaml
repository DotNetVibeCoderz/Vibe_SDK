<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepthAI.Sample.DetectionDashboard.MainWindow"
        Width="1100" Height="720"
        Background="#0E1417"
        Title="Dashboard Deteksi Objek">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
      <TextBlock Text="Dashboard Deteksi Objek" Foreground="#E8F1F2" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="Subtitle" Text="Menghubungkan…" Foreground="#8CA3AD" FontSize="12" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,260">
      <Border Background="#141C21" CornerRadius="8" ClipToBounds="True">
        <Image x:Name="Preview" Stretch="Uniform" />
      </Border>
      <Border Grid.Column="1" Margin="12,0,0,0" Padding="12"
              Background="#141C21" CornerRadius="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="OBJEK TERDETEKSI"
                     Foreground="#8CA3AD" FontSize="11" FontWeight="SemiBold"
                     Margin="0,0,0,10" />
          <ItemsControl x:Name="DetectionList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#1B252B" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                  <TextBlock Text="{Binding}" Foreground="#E8F1F2" FontSize="12" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,8"
            Background="#141C21" CornerRadius="6">
      <TextBlock x:Name="Status" Text="Siap" Foreground="#8CA3AD" FontSize="12" />
    </Border>

  </Grid>
</Window>