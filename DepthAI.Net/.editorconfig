root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,csproj,props,targets,xaml,axaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_when_type_is_apparent = true:suggestion

# Analyzer noise yang tidak relevan untuk SDK interop / UI app.
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates
dotnet_diagnostic.CA1031.severity = none   # catch general exception
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait
dotnet_diagnostic.CA1707.severity = none   # underscore in native names
dotnet_diagnostic.CA1720.severity = none   # identifier contains type name
dotnet_diagnostic.CA1819.severity = none   # properties returning arrays (frame buffers)
dotnet_diagnostic.CA1873.severity = none   # ToString() in log args
dotnet_diagnostic.CA1711.severity = none   # IFrameStream/*Stream naming is deliberate
