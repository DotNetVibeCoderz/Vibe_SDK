<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Unitree.Net.Dashboard.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* Interactive, or the whole application is static server-side rendering: buttons render but have
       no handler attached, and a timer calling StateHasChanged updates nothing. The control page
       looked completely normal and did nothing at all, and the telemetry page showed one snapshot
       frozen at the moment it was rendered. *@
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
