<Window x:Class="Unitree.Net.Wizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:Unitree.Net.Wizard.Components"
        Title="Unitree Robot Wizard"
        Height="960" Width="1640"
        MinHeight="640" MinWidth="1100"
        Background="#0f1319"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <blazor:BlazorWebView x:Name="Host" HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Root}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>

</Window>
