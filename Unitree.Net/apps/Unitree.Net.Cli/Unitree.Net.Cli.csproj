<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>unitree</AssemblyName>
    <RootNamespace>Unitree.Net.Cli</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unitree.Net.Extensions.DependencyInjection\Unitree.Net.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Unitree.Net.Manipulation\Unitree.Net.Manipulation.csproj" />
    <!-- For `unitree templates` and `unitree new`. The template catalogue lives in one place so the
         wizard, the VS Code extension and this tool cannot disagree about what exists. -->
    <ProjectReference Include="..\..\src\Unitree.Net.Wizard.Core\Unitree.Net.Wizard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
