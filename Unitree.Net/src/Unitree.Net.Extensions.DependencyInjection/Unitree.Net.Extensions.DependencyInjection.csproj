<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Dependency-injection wiring for Unitree.Net: registers the transport, robot, telemetry, metrics, health checks and AI workflow engine from configuration.</Description>
    <RootNamespace>Unitree.Net.Extensions.DependencyInjection</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unitree.Net.Core\Unitree.Net.Core.csproj" />
    <ProjectReference Include="..\Unitree.Net.Dds\Unitree.Net.Dds.csproj" />
    <ProjectReference Include="..\Unitree.Net.Interop\Unitree.Net.Interop.csproj" />
    <ProjectReference Include="..\Unitree.Net.Control\Unitree.Net.Control.csproj" />
    <ProjectReference Include="..\Unitree.Net.Sensors\Unitree.Net.Sensors.csproj" />
    <ProjectReference Include="..\Unitree.Net.Diagnostics\Unitree.Net.Diagnostics.csproj" />
    <ProjectReference Include="..\Unitree.Net.Ai\Unitree.Net.Ai.csproj" />
    <ProjectReference Include="..\Unitree.Net.Ros2\Unitree.Net.Ros2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

</Project>
