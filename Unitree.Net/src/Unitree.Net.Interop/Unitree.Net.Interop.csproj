<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>P/Invoke bindings to the unitree_net_native Cyclone DDS shim, providing a wire-compatible transport for Unitree robot firmware.</Description>
    <!-- LibraryImport requires unsafe for the generated marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unitree.Net.Core\Unitree.Net.Core.csproj" />
    <ProjectReference Include="..\Unitree.Net.Dds\Unitree.Net.Dds.csproj" />
    <ProjectReference Include="..\Unitree.Net.Messages\Unitree.Net.Messages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
